# Copiá este archivo como .env y completá tus claves (el .env NO se sube al repo).
# Son las mismas variables que la Pre-entrega 1: podés reutilizar ese .env.

# Proveedor por defecto: openai | anthropic | gemini
LLM_PROVIDER=gemini

# API keys (solo es obligatoria la del proveedor que uses)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Gemini tiene plan gratuito sin tarjeta: https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Modelos (opcionales; estos son los valores por defecto)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
# gemini-flash-lite-latest tiene más cuota gratuita diaria que gemini-flash-latest (20 pedidos/día)
GEMINI_MODEL=gemini-flash-lite-latest

# Máximo de tokens de salida (opcional)
LLM_MAX_TOKENS=1024
